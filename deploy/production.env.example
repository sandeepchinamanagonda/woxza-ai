# Copy this to .env.production on the OCI VM and replace every example value.
# Keep this file on the VM only; it must never be committed.
POSTGRES_DB=voxa
POSTGRES_USER=voxa
POSTGRES_PASSWORD=generate-a-long-random-password
API_PORT=8787
WEB_PORT=127.0.0.1:3456

PUBLIC_API_URL=https://api.woxza.io
WEBSITE_URL=https://woxza.io
CORS_ORIGINS=https://woxza.io

# Required for the public India live-call path.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_STREAM_CONTENT_TYPE=audio/x-l16;rate=16000
PLIVO_L16_BYTE_ORDER=little

# V3 is selected by the server after the website posts to /api/demo/call.
# There is no separate V3 browser endpoint.
VOICE_PIPELINE=v3

# Sarvam is the tested V3 STT, TTS, and conversation provider.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_CHAT_MODEL=sarvam-105b-conversations
V3_BRAIN_PROVIDER=sarvam
V3_TTS_PROVIDER=sarvam
V3_TTS_FALLBACK=sarvam

# Keep blank unless a real Sarvam pronunciation dictionary is created. Blank
# uses the version-controlled 13-language local brand pronunciation fallback.
SARVAM_TTS_PRONUNCIATION_DICT_ID=
SARVAM_TTS_PACE=1.15
SARVAM_TTS_TEMPERATURE=0.70
SARVAM_TTS_PACE_TE=1.15
SARVAM_TTS_TEMPERATURE_TE=0.72
SARVAM_TTS_SPEAKER=ishita
# Ranked voice policy: female #1, female #2, male #3. The first is used for
# calls; the rest are approved alternatives, not per-turn rotation.
SARVAM_TTS_SPEAKER_ORDER_AS=priya,ishita,shubh
SARVAM_TTS_SPEAKER_ORDER_BN=roopa,suhani,rehan
SARVAM_TTS_SPEAKER_ORDER_EN=ishita,priya,ratan
SARVAM_TTS_SPEAKER_ORDER_GU=priya,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_HI=priya,suhani,shubh
SARVAM_TTS_SPEAKER_ORDER_KN=ishita,neha,ratan
SARVAM_TTS_SPEAKER_ORDER_ML=pooja,priya,shubh
SARVAM_TTS_SPEAKER_ORDER_MR=priya,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_PA=roopa,suhani,mani
SARVAM_TTS_SPEAKER_ORDER_TA=ishita,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_TE=priya,ritu,shubh
SARVAM_TTS_SPEAKER_ORDER_UR=priya,ishita,shubh

# Preserve the phone pacing and barge-in behaviour that passed local calls.
V3_STT_MODEL=saaras:v3-realtime
V3_STT_MODE=codemix
V3_STT_STREAM_TYPE=fast
V3_STT_SILENCE_MS=500
V3_STT_MIN_SPEECH_MS=250
V3_LANGUAGE_SWITCH_POLICY=locked
V3_TURN_CONTROL=provider
V3_TURN_START_FRAMES=2
V3_TURN_ENDPOINT_SILENCE_MS=750
V3_TURN_PRE_ROLL_FRAMES=10
SPEAK_FIRST=true
SPEAK_FIRST_TIMEOUT_ENABLED=true
SPEAK_FIRST_TIMEOUT_SECONDS=6
V3_OPENING_DELIVERY_RETRY_ENABLED=true
V3_OPENING_DELIVERY_TIMEOUT_SECONDS=5
V3_OPENING_DELIVERY_MAX_ATTEMPTS=2
V3_STREAM_RESUME_ENABLED=true
V3_STREAM_RESUME_GRACE_SECONDS=20
V3_STREAM_RESUME_HISTORY_TURNS=16
V3_WOXZA_PHRASE_MIN_CHARS=60
V3_WOXZA_PHRASE_MAX_CHARS=140
V3_WOXZA_PHRASE_MAX_WAIT_MS=0
V3_SARVAM_TTS_MIN_BUFFER_CHARS=60
V3_TTS_MIN_BUFFER_CHARS=60
V3_TTS_MAX_CHUNK_CHARS=200
V3_TTS_CHUNKER=prosody
V3_TTS_DELIVERY_MODE=turn
V3_PHONE_REPLY_MAX_CHARS=240
V3_FULL_PICTURE_MAX_CHARS=1200

# The legacy in-memory matcher is retained only as an explicit rollback aid.
# The persisted route router below owns the normal Phase 3 shadow rollout.
V3_SEMANTIC_INTENT_ROUTER=off
V3_SEMANTIC_INTENT_CATALOG_PATH=
# Phase 3: decisions are logged for review and never change caller speech.
# `active` is intentionally not accepted by this router until Phase 5.
V3_SEMANTIC_ROUTE_ROUTER=shadow
# Phase 1 persisted index source and destination. Leave blank to use the
# packaged full-value catalog and backend/.runtime/semantic-route-index path.
V3_SEMANTIC_ROUTE_CATALOG_PATH=
V3_SEMANTIC_ROUTE_INDEX_PATH=

# Normal replies stay short. The separate full-picture budget permits four
# concrete examples after a caller explicitly asks for them.
VOICE_RESPONSE_MAX_TOKENS=56
VOICE_RESPONSE_MAX_TOKENS_TE=160
VOICE_FULL_PICTURE_MAX_TOKENS=256
VOICE_FULL_PICTURE_MAX_TOKENS_TE=256
VOICE_REPAIR_MAX_TOKENS=72
VOICE_REPAIR_MAX_TOKENS_TE=112

# Per-call cost ledger values. Provider invoices remain authoritative.
VOICE_COST_ESTIMATION_VERSION=sarvam-2026-09
VOICE_COST_SARVAM_TTS_INR_PER_1K_CHARS=3
VOICE_COST_SARVAM_STT_V3_INR_PER_MIN=0.30
VOICE_COST_SARVAM_STT_V4_INR_PER_MIN=0.50
VOICE_COST_SARVAM_105B_INPUT_INR_PER_MILLION=29.28
VOICE_COST_SARVAM_105B_CACHED_INPUT_INR_PER_MILLION=10.98
VOICE_COST_SARVAM_105B_OUTPUT_INR_PER_MILLION=73.20

# Only needed if the V3 brain or semantic-router mode changes to Gemini.
GEMINI_API_KEY=
V3_GEMINI_MODEL=gemini-2.5-flash
V3_GEMINI_INPUT_USD_PER_MILLION=0.30
V3_GEMINI_CACHED_INPUT_USD_PER_MILLION=0.03
V3_GEMINI_OUTPUT_USD_PER_MILLION=2.50
VOICE_COST_USD_TO_INR=94.50
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
# Set only for the first deployment (eight characters or longer) to create the three allowlisted staff accounts;
# remove it after seeding. Never commit a real password.
ADMIN_INITIAL_PASSWORD=
RESEND_API_KEY=
DEMO_EMAIL_FROM="Woxza <demo@example.com>"
UNSUBSCRIBE_SIGNING_SECRET=generate-at-least-32-random-characters
