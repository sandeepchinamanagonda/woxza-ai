# Copy this file to .env. Never commit .env or real secrets.

# Docker/PostgreSQL — local values are fine for development; change them for shared environments.
POSTGRES_DB=voxa
POSTGRES_USER=voxa
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_PORT=5432
API_PORT=8787
WEB_PORT=3456

# Public URL used by Plivo/Twilio to reach the local API. setup.sh replaces this
# with the active ngrok HTTPS URL; do not enter a localhost URL here.
PUBLIC_API_URL=https://replace-me.ngrok-free.app
WEBSITE_URL=http://localhost:3456
CORS_ORIGINS=http://localhost:3456

# Gemini Live — create an API key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_DEMO_VOICE=Kore
# v1 is Gemini Live; v2 is the stable batch Sarvam pipeline; v3 is the
# experimental continuous Plivo ↔ Sarvam streaming pipeline. Roll back from
# v3 instantly by setting this to v2 and restarting the API.
VOICE_PIPELINE=v1
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
V2_STT_MODE=codemix
# `unknown` detects language for every caller utterance. Set a specific BCP-47
# code only if the entire call must stay in one language.
V2_STT_LANGUAGE_CODE=unknown
SARVAM_TTS_MODEL=bulbul:v3
# Default only when a language does not have its own setting below.
# Each language setting is the first-choice voice for that language.  The
# order comments are the audition/fallback order; change the first value only
# after listening to the corresponding call language.
SARVAM_TTS_SPEAKER=ishita
SARVAM_TTS_PRONUNCIATION_DICT_ID=
SARVAM_TTS_PACE=1.15
SARVAM_TTS_TEMPERATURE=0.70
# Voice policy for every language currently exposed in the India demo UI.
# Format: female #1, female #2, male #3. Calls use #1 consistently. The
# others are the approved alternatives for a controlled bake-off or failover;
# do not rotate voices between turns.
SARVAM_TTS_SPEAKER_ORDER_AS=priya,ishita,shubh
SARVAM_TTS_SPEAKER_ORDER_BN=roopa,suhani,rehan
SARVAM_TTS_SPEAKER_ORDER_EN=ishita,priya,ratan
SARVAM_TTS_SPEAKER_ORDER_GU=priya,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_HI=priya,suhani,shubh
SARVAM_TTS_SPEAKER_ORDER_KN=ishita,neha,ratan
SARVAM_TTS_SPEAKER_ORDER_ML=pooja,priya,shubh
SARVAM_TTS_SPEAKER_ORDER_MR=priya,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_PA=roopa,suhani,mani
SARVAM_TTS_SPEAKER_ORDER_TA=ishita,ritu,ratan
SARVAM_TTS_SPEAKER_ORDER_TE=priya,ritu,shubh
SARVAM_TTS_SPEAKER_ORDER_UR=priya,ishita,shubh
# Optional explicit choice after a language audition. A named language choice
# overrides the ranked policy above; for example, keep Ritu for Telugu.
SARVAM_TTS_SPEAKER_TE=
# Telugu is more syllable-dense than English; retain the pace that passed the
# live phone test. Other languages inherit the general settings above.
SARVAM_TTS_PACE_TE=1.15
SARVAM_TTS_TEMPERATURE_TE=0.72
# Per-call cost telemetry. Values are estimates from the current Sarvam rate
# card/dashboard; invoices remain the source of truth. They apply in both
# local Docker Compose and production because Compose passes them through.
VOICE_COST_ESTIMATION_VERSION=sarvam-2026-09
VOICE_COST_SARVAM_TTS_INR_PER_1K_CHARS=3
VOICE_COST_SARVAM_STT_V3_INR_PER_MIN=0.30
VOICE_COST_SARVAM_STT_V4_INR_PER_MIN=0.50
VOICE_COST_SARVAM_105B_INPUT_INR_PER_MILLION=29.28
VOICE_COST_SARVAM_105B_CACHED_INPUT_INR_PER_MILLION=10.98
VOICE_COST_SARVAM_105B_OUTPUT_INR_PER_MILLION=73.20
V2_TTS_CODEC=linear16
V2_TTS_SAMPLE_RATE=16000
OPENROUTER_API_KEY=
# `openrouter/free` is for evaluation only. Pin a paid, benchmarked model
# before enabling V2 for public traffic.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
V2_BRAIN_PROVIDER=sarvam
SARVAM_CHAT_MODEL=sarvam-105b-conversations
# Safety ceiling for one LLM response. Telugu needs a larger allowance than
# English to finish a complete local-language question. The phone renderer
# separately enforces the concise audible turn.
# Provider-independent ceiling used by every text brain (Sarvam, Claude,
# OpenAI, or OpenRouter). Telugu needs a larger allowance to finish naturally.
VOICE_RESPONSE_MAX_TOKENS=56
VOICE_RESPONSE_MAX_TOKENS_TE=160
# Only used for the explicit, six-sentence "how can Woxza help?" explanation.
# Normal phone replies retain the smaller limits above.
VOICE_FULL_PICTURE_MAX_TOKENS=256
VOICE_FULL_PICTURE_MAX_TOKENS_TE=256
# Used only when a normal response was provider-truncated. This produces a
# complete concise replacement instead of speaking an abandoned opening.
VOICE_REPAIR_MAX_TOKENS=72
VOICE_REPAIR_MAX_TOKENS_TE=112
V2_TTS_PROVIDER=sarvam
FISH_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Keep this enabled while we establish Fish's Telugu/Hindi/Tamil quality.
V2_TTS_FALLBACK=sarvam
V2_END_SILENCE_MS=750
# If the experimental free brain stalls, speak a short safe fallback rather
# than leaving the caller in silence.
V2_LLM_TIMEOUT_MS=3000
# Enable Sarvam model SSE and begin TTS at complete phrase boundaries.
V2_RESPONSE_STREAMING=false
V2_TTS_PHRASE_MIN_CHARS=18

# V3 continuous, bidirectional audio — opt in only after live testing.
# Saaras realtime owns speech boundaries and emits partial/final transcripts
# while Plivo PCM frames are still arriving.
V3_STT_MODEL=saaras:v3-realtime
V3_STT_MODE=codemix
V3_STT_STREAM_TYPE=fast
V3_STT_SILENCE_MS=500
V3_STT_MIN_SPEECH_MS=250
# UI language is the initial active language. `confirm` keeps it stable through
# normal code-mixing and asks once before a sustained different-language turn
# changes the response language and TTS voice. `locked` restores the old mode.
V3_LANGUAGE_SWITCH_POLICY=locked
# Woxza conversation control: hybrid is the recommended live mode—Sarvam owns
# VAD/boundaries while Woxza owns response and interruption policy. Provider
# preserves the old baseline; bridge remains an experimental rollback option.
V3_TURN_CONTROL=provider
V3_TURN_START_FRAMES=2
# Candidate audio is confirmed by meaningful STT words, not energy alone.
# This prevents breathing and background noise from cutting off Woxza.
V3_TURN_ENDPOINT_SILENCE_MS=750
V3_TURN_PRE_ROLL_FRAMES=10
# Call-start policy. The current website demo should remain agent-first.
# Caller-first is for a future inbound product flow; its one-time timeout
# prompt prevents a confusing silent call.
SPEAK_FIRST=true
SPEAK_FIRST_TIMEOUT_ENABLED=true
SPEAK_FIRST_TIMEOUT_SECONDS=6
# Agent-first delivery watchdog. A greeting counts as delivered only once its
# first audio frame reaches Plivo; after five seconds Woxza retries TTS once.
V3_OPENING_DELIVERY_RETRY_ENABLED=true
V3_OPENING_DELIVERY_TIMEOUT_SECONDS=5
V3_OPENING_DELIVERY_MAX_ATTEMPTS=2
# A temporary Plivo media-socket loss restores only durable, fully delivered
# conversation turns. It never replays old speech or the opening greeting.
V3_STREAM_RESUME_ENABLED=true
V3_STREAM_RESUME_GRACE_SECONDS=20
V3_STREAM_RESUME_HISTORY_TURNS=16
# Two independent buffers are intentional. Woxza holds model fragments until
# a complete thought is ready; Sarvam holds only already-approved text inside
# its own WebSocket. Keep both at 60 for the existing V3 behaviour.
V3_WOXZA_PHRASE_MIN_CHARS=60
V3_WOXZA_PHRASE_MAX_CHARS=140
V3_WOXZA_PHRASE_MAX_WAIT_MS=0
V3_SARVAM_TTS_MIN_BUFFER_CHARS=60
# Legacy fallback retained for simple rollback to an earlier V3 deployment.
V3_TTS_MIN_BUFFER_CHARS=60
V3_TTS_MAX_CHUNK_CHARS=200
# `prosody` waits for complete spoken phrases; `legacy` restores the earlier
# word-boundary behaviour. The first setting falls back to V3_TTS_MIN_BUFFER_CHARS.
V3_TTS_CHUNKER=prosody
# `turn` sends one short completed reply to TTS for smoother speech. Set
# `phrase` only to evaluate early phrase playback again.
V3_TTS_DELIVERY_MODE=turn
# V3 TTS provider: `sarvam` is the default. Set `indic` to use the local
# AI4Bharat Indic-TTS A/B service. Any service or synthesis failure retries
# Sarvam unless you explicitly set V3_TTS_FALLBACK=none.
V3_TTS_PROVIDER=sarvam
V3_TTS_FALLBACK=sarvam
INDIC_TTS_URL=http://host.docker.internal:5050
INDIC_TTS_SPEAKER=female
INDIC_TTS_SPEAKER_TE=female
# Legacy Woxza phrase names retained as compatibility fallbacks.
V3_TTS_PHRASE_MIN_CHARS=
V3_TTS_PHRASE_MAX_CHARS=140
V3_TTS_PHRASE_MAX_WAIT_MS=0
# Application-level ceiling for a normal complete phone reply. Independent
# from Sarvam buffering and used to reduce long-turn TTS spend.
# Backstop only: Gemini is asked to stay shorter than this. It is large enough
# for a complete Telugu acknowledgement plus one question, but not a speech.
V3_PHONE_REPLY_MAX_CHARS=240
# Six-to-seven-sentence value explanations are permitted this higher ceiling;
# normal replies continue to use V3_PHONE_REPLY_MAX_CHARS.
V3_FULL_PICTURE_MAX_CHARS=1200
# The legacy in-memory matcher is an explicit rollback option only. The
# persisted route router below owns the normal shadow rollout.
V3_SEMANTIC_INTENT_ROUTER=off
# Optional absolute runtime path; blank uses backend/demo_prompts.
V3_SEMANTIC_INTENT_CATALOG_PATH=
# Shadow mode observes decisions but never changes caller-facing behaviour.
# `active` is for a controlled local rollout only: clear deterministic answers
# still win; unfamiliar wording must clear the semantic thresholds in time.
V3_SEMANTIC_ROUTE_ROUTER=shadow
# Bounded active-mode caller wait (100-1500ms). Timeout always falls back.
V3_SEMANTIC_ROUTE_TIMEOUT_MS=650
# Optional absolute catalog and durable index locations. Blank uses defaults.
V3_SEMANTIC_ROUTE_CATALOG_PATH=
V3_SEMANTIC_ROUTE_INDEX_PATH=
# Select one direct text brain for V3: sarvam, gemini, openai, or anthropic.
V3_BRAIN_PROVIDER=sarvam
V3_GEMINI_MODEL=gemini-2.5-flash
# Text-only Gemini pricing for local per-call telemetry. Update these from
# Google's pricing page if the selected model changes.
V3_GEMINI_INPUT_USD_PER_MILLION=0.30
# Cached input is a subset of prompt tokens and is metered separately.
V3_GEMINI_CACHED_INPUT_USD_PER_MILLION=0.03
V3_GEMINI_OUTPUT_USD_PER_MILLION=2.50
# Exchange rate used only for estimates; provider invoices remain authoritative.
VOICE_COST_USD_TO_INR=94.50
OPENAI_API_KEY=
V3_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
V3_ANTHROPIC_MODEL=claude-sonnet-4-6

# India / Plivo voice — from the Plivo console: https://console.plivo.com/
PLIVO_AUTH_ID=replace-with-plivo-auth-id
PLIVO_AUTH_TOKEN=replace-with-plivo-auth-token
PLIVO_FROM_NUMBER=+910000000000
# Use wideband PCM for clearer recognition of Indian-language and brand-name speech.
PLIVO_STREAM_CONTENT_TYPE=audio/x-l16;rate=16000
# Plivo media payload byte order. Keep `little` for the XML AudioStream endpoint.
PLIVO_L16_BYTE_ORDER=little

# US / Twilio voice — from the Twilio Console: https://console.twilio.com/
# Use TWILIO_AUTH_TOKEN, or a TWILIO_API_KEY_SID plus TWILIO_API_KEY_SECRET.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# ngrok — install from https://ngrok.com/download and obtain an authtoken from
# https://dashboard.ngrok.com/get-started/your-authtoken. Optional when ngrok
# has already been configured with `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=
# Optional reserved ngrok domain, for example demo.example.ngrok-free.app.
NGROK_DOMAIN=
# setup.sh searches both the standard 4040 inspector and the previous local 4041 inspector.
NGROK_INSPECTOR_PORTS="4040 4041"

# Frontend — leave blank for Docker/Nginx same-origin API proxy. Set an API URL
# only when running the Vite frontend outside Docker. These two flags are for
# local development only: setup.sh enables and secures local admin access. The
# production compose file keeps both modes off by default.
VITE_API_BASE_URL=
VITE_LOCAL_ADMIN_MODE=false
VITE_LOCAL_ADMIN_TOKEN=
LOCAL_ADMIN_MODE=false
LOCAL_ADMIN_TOKEN=

# Optional local test phone that bypasses public demo rate limits. Use E.164 format.
DEMO_TEST_PHONE=

# Optional end-to-end startup smoke test. When true, setup.sh creates this call
# and waits for it to connect before reporting success. Keep false by default.
LOCAL_SETUP_TEST_CALL=false
LOCAL_SETUP_TEST_PHONE=
LOCAL_SETUP_TEST_NAME=Sabdeep
LOCAL_SETUP_TEST_LANGUAGE=en
LOCAL_SETUP_TEST_TIMEOUT_SECONDS=90

# Admin lead export — create a long random value locally, for example with `openssl rand -hex 32`.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Optional Resend follow-up emails — create an API key at https://resend.com/api-keys.
RESEND_API_KEY=
DEMO_EMAIL_FROM="Woxza <demo@example.com>"

# HMAC secret for unsubscribe links — generate with `openssl rand -hex 32`.
UNSUBSCRIBE_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Local-only Node database overrides. Docker Compose supplies PG* automatically;
# use one of these only when running `node backend/src/server.js` directly.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=voxa
PGUSER=voxa
PGPASSWORD=
DB_POOL_SIZE=10
DB_CONNECT_RETRIES=20
REDIS_URL=redis://localhost:6379
PORT=8787

# Legacy Exotel compatibility values. The current public demo routes India via
# Plivo and US numbers via Twilio; these are not required for the current flow.
TELEPHONY_PROVIDER=plivo
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_EXOPHONE=
EXOTEL_APP_ID=
GEMINI_LIVE_BRIDGE_URL=
